# HUIDI Docs Online
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
DATABASE_URL=sqlite:///./huidi-online.db

# Required for encrypting mailbox credentials at rest.
# Use a long random value in production and keep it stable across restarts/backups.
HUIDI_SECRET_KEY=

# Search provider
SERPER_API_KEY=

# OpenAI-compatible LLM provider
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Product defaults
HUIDI_DEFAULT_SENDER_NAME=
HUIDI_DEFAULT_SENDER_COMPANY=
HUIDI_DEFAULT_SENDER_TITLE=Business Development Manager
HUIDI_DEFAULT_SENDER_EMAIL=
HUIDI_DEFAULT_WHATSAPP=
