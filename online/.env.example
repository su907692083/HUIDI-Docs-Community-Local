# HUIDI Online
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
DATABASE_URL=sqlite:///./huidi-online.db

# Public origin used in password-reset and OAuth callback links.
# Example: https://online.example.com
HUIDI_PUBLIC_BASE_URL=

# Server safety key. Use one long random value and keep it stable.
HUIDI_SECRET_KEY=

# Published Community workspace as the Online mother surface.
# Keep 1 for the current fused Online UI.
HUIDI_COMMUNITY_SURFACE=1

# Set 1 only for isolated tests/maintenance that must suppress mail/jobs.
HUIDI_DISABLE_BACKGROUND_JOBS=0

# Default company work timezone before a company saves its own setting.
HUIDI_TIMEZONE=Asia/Shanghai

# Public account/login gate.
# Public registration creates organization #2+ only. It never joins the
# historical/platform organization #1 automatically.
HUIDI_TEAM_ACCESS=0
HUIDI_SIGNUP_ENABLED=1
HUIDI_DEFAULT_ORGANIZATION_NAME=HUIDI Workspace
HUIDI_OWNER_EMAIL=
HUIDI_OWNER_NAME=
HUIDI_OWNER_PASSWORD=

# Password-reset transactional email (separate from a user's business mailbox).
HUIDI_AUTH_SMTP_HOST=
HUIDI_AUTH_SMTP_PORT=587
HUIDI_AUTH_SMTP_SECURITY=starttls
HUIDI_AUTH_SMTP_USERNAME=
HUIDI_AUTH_SMTP_PASSWORD=
HUIDI_AUTH_EMAIL_FROM=

# Phone OTP. Use either a trusted HTTPS webhook or Twilio.
# The custom webhook receives JSON:
# {"phone":"+86138...","code":"123456","purpose":"login","product":"HUIDI Online"}
HUIDI_SMS_WEBHOOK_URL=
HUIDI_SMS_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WeChat Open Platform website QR login.
HUIDI_WECHAT_APP_ID=
HUIDI_WECHAT_APP_SECRET=
HUIDI_WECHAT_REDIRECT_URI=

# Feishu Web OAuth login.
HUIDI_FEISHU_APP_ID=
HUIDI_FEISHU_APP_SECRET=
HUIDI_FEISHU_REDIRECT_URI=

# Multi-company storage.
# SQLite automatically keeps organization #1 in DATABASE_URL and creates
# organization #2+ in separate database files beside it.
# For production PostgreSQL, use the installed psycopg driver and provide a URL
# template containing the literal placeholder {organization_id}, so every
# company uses a physically separate database.
# Example shapes only:
# DATABASE_URL=postgresql+psycopg://user:pass@db-host/huidi_org_1
# HUIDI_TENANT_DATABASE_URL_TEMPLATE=postgresql+psycopg://user:pass@db-host/huidi_org_{organization_id}
HUIDI_TENANT_DATABASE_URL_TEMPLATE=
# Before a production deployment, run the explicit schema tool from online/api:
# python -m app.schema_cli check --all
# python -m app.schema_cli upgrade --all
# python -m app.schema_cli check --all

# Company business backups for SQLite deployments.
# Keep this directory outside any public web directory and persist it with the server volume.
HUIDI_BACKUP_DIR=./backups
HUIDI_BACKUP_KEEP=30
# Automatic backup is on by default. 24 means one verified backup per company about once a day.
HUIDI_AUTO_BACKUP=1
HUIDI_AUTO_BACKUP_HOURS=24

# Lead search / map / market news
SERPER_API_KEY=

# Optional acquisition/news providers used by the current Online workbench.
# Serper remains a primary public search source when configured. Tavily can
# provide company-search failover; Hunter is preferred for public contact lookup.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
HUNTER_API_KEY=
HUNTER_BASE_URL=https://api.hunter.io/v2
GNEWS_API_KEY=

# Gmail connection
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Outlook connection
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=common
OUTLOOK_REDIRECT_URI=

# Mail status callback protection
HUIDI_MAIL_EVENT_KEY=

# Commercial data-service endpoints are public-network only by default.
# Set to 1 only when your company intentionally connects HUIDI to a trusted private-network service.
HUIDI_ALLOW_PRIVATE_SERVICE_ENDPOINTS=0

# Company verification data service
HUIDI_COMPANY_LOOKUP_URL=
HUIDI_COMPANY_LOOKUP_TOKEN=

# Trade / customs data service
HUIDI_TRADE_DATA_URL=
HUIDI_TRADE_DATA_TOKEN=

# HS / tariff data service
HUIDI_TARIFF_LOOKUP_URL=
HUIDI_TARIFF_LOOKUP_TOKEN=

# Shipping / schedule data service
HUIDI_SHIPPING_API_URL=
HUIDI_SHIPPING_API_TOKEN=

# AI writing provider
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Product defaults
HUIDI_DEFAULT_SENDER_NAME=
HUIDI_DEFAULT_SENDER_COMPANY=
HUIDI_DEFAULT_SENDER_TITLE=Business Development Manager
HUIDI_DEFAULT_SENDER_EMAIL=
HUIDI_DEFAULT_WHATSAPP=
